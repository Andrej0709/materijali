{
  "name": "odeljenje",
  "version": "1.0.0",
  "private": true,
  "description": "Web aplikacija za deljenje materijala u odeljenju",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:vendor": "esbuild scripts/blob-entry.js --bundle --format=esm --platform=browser --minify --target=es2020 --legal-comments=none --define:process.env={} --outfile=public/js/vendor/blob-client.js",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.2",
    "express": "^4.21.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
